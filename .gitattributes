# Normaliza quebras de linha: LF no repositorio (deploy roda em Linux/VPS)
* text=auto eol=lf

# Scripts Windows precisam de CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binarios (nunca normalizar)
*.docx binary
*.xlsx binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.ico  binary

{
  "name": "CORBELINO_ADVOGADOS - Agente Operacional CORBELINO.IA (LOCAL)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "id": "trigger-schedule",
      "name": "A cada 2 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://app.advbox.com.br/api/v1/posts",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "per_page",
              "value": "200"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer "
            },
            {
              "name": "User-Agent",
              "value": "CORBELINO_ADVOGADOS-Advocacia/1.0"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "http-listar-tarefas",
      "name": "ADVBOX: listar tarefas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      },
      "id": "split-out",
      "name": "Separar tarefas",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "agente-pendente",
              "leftValue": "={{ ($json.users || []).filter(u => u.user_id === SEU_ADVBOX_USER_AGENTE && !u.completed).length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filter-agente",
      "name": "So CORBELINO.IA pendente",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8787/tarefa",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer "
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ task: $json }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "http-disparar-agente",
      "name": "Disparar Agente Operacional",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ]
    }
  ],
  "connections": {
    "A cada 2 min": {
      "main": [
        [
          {
            "node": "ADVBOX: listar tarefas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ADVBOX: listar tarefas": {
      "main": [
        [
          {
            "node": "Separar tarefas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Separar tarefas": {
      "main": [
        [
          {
            "node": "So CORBELINO.IA pendente",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "So CORBELINO.IA pendente": {
      "main": [
        [
          {
            "node": "Disparar Agente Operacional",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "CORBELINO_ADVOGADOS"
    },
    {
      "name": "Agente Operacional"
    }
  ]
}
